# Normalise to LF in the repo, check out native. Windows-only project, but this
# keeps diffs sane if anyone ever opens it elsewhere.
* text=auto

*.cmd  text eol=crlf
*.ps1  text eol=crlf
*.cs   text
*.md   text

# LF, always. These run on Linux, and a CRLF shebang line makes the kernel
# report "bad interpreter" -- which also bites when the Windows working copy
# is executed from WSL over /mnt/c.
*.py   text eol=lf
*.sh   text eol=lf
linux/** text eol=lf
